+#lINKED lISTS WERE created to overcome the drawbacks associated with storing data
+# in regular lists, arrays, as outlined below.
+#1. Ease of insertion and deletion of data
+#They store elements in non-contiguous memory locations and connect them through the use of pointers to subsequent nodes
+#We only modify nodes
+#2. The aspect of dynamic size, linked lists grow and shrink dynamically compared to
+#arrays and lists which need complex operations to grow.
+
+class Node: #A node is an element that stores data and reference to the next node
+    def __init__(self, data):
+        self.data = data #Assigns the given data to the node
+        self.next = None #Sets the next attribute pointer to null.  As we continue to add new nodes, this attribute will be updated to point to the next node
+
+"""
+We will start by initializing the linked list which will encapsulate all the operations for managing the nodes, such as insertion and removal
+"""""
+
+class LinkedList:
+
+    ##We add a new method to create a new node and place it at the start of the list
+    def insertAtBeginning(self, new_data):  # EVerytime this method is called a new node is created
+        # and it is made the top of the list. The next pointer of this node is set to the current head of the list,
+        # which will place this new node infornt of all the existing nodes
+        new_node = Node(new_data)
+        new_node.next = self.head
+        self.head = new_node
+
+    def insertAtEnd(self, new_data):  # Inserting a new nod at the end of the list
+        new_node = Node(new_data)  # Creates a new node
+
+        if self.head is None:  # If the list is empty, make the new node the head
+            self.head = new_node
+            return
+
+        last = self.head
+
+        while last.next:  # Otherwise traverse the list to find the last node
+            last = last.next
+
+        last.next = new_node  # Make the new node the next node of the last node
+
+    def printList(self):
+        temp = self.head  # Starts from the head of the list
+        while temp:
+            print(temp.data, end=' ')  # Prints the data in the current node
+            temp = temp.next  # Move to the next node
+        print()
+
+
+    def __init__(self):
+        self.head = None
+        #The init method is a special method in python classes, known as a constructor
+        #This constructor is called when an object is created from the class and, it allows the class to initialize the attributes.
+
+        ##By setting self.head to None, we are stating that the Linked lists is initially empty
+        ##And that there are no nodes in the list to point to, we will now proceed to populate the list by inserting new  nodes
+
+
+if __name__ == '__main__':
+    #Create a new instance of LinkedList
+    llist = LinkedList()
+
+    #Insert each element at the beginning using the method we created
+    llist.insertAtBeginning('jumps')
+    llist.insertAtBeginning('fox')
+    llist.insertAtBeginning('brown')
+    llist.insertAtBeginning('quick')
+    llist.insertAtBeginning('the')
+
+    #Now 'the' is the head of the list followed by 'quick' then 'brown' and finally 'fox'
+    #print the list
+    llist.printList()
+    #Insert a word at the end
+    llist.insertAtEnd('over the lazy dog')
+
+    llist.printList()
+    
+
+
